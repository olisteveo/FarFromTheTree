.sbox/*
*.generated.*
*.*_c
!*.shader_c
*.los
*.vpk
*launchSettings.json
*.sln
*.slnx

*idea

# Exported / standalone games
Exports/
web/tools/audio/__pycache__
web/tools/cutscene/*.tsrct
web/tools/cutscene/intro.mp4
web/tools/cutscene/.tesseract-work/
